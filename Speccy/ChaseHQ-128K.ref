;
; SkoolKit ref file for Chase H.Q. by Ocean.
;

[Config]
HtmlWriterClass=:ChaseHQ.ChaseHQHtmlWriter
GameDir=ChaseHQ

[Paths]
CodeFiles={address:04X}.html

; Each 128K RAM bank is paged into the same $C000-$FFFF window, so it gets
; its own OtherCode disassembly rather than sharing the main one. This lets
; #R address@bankN link between banks despite the overlapping addresses.
[OtherCode:main]
Source=ChaseHQ-128K.skool
[OtherCode:bank1]
Source=ChaseHQ-128K-bank-1.skool
[OtherCode:bank3]
Source=ChaseHQ-128K-bank-3.skool
[OtherCode:bank4]
Source=ChaseHQ-128K-bank-4.skool
[OtherCode:bank6]
Source=ChaseHQ-128K-bank-6.skool
[OtherCode:bank7]
Source=ChaseHQ-128K-bank-7.skool

[Game]
Game=Chase H.Q.
StyleSheet=chase-hq.css
Release=The incomplete Chase H.Q. disassembly 20260814
Copyright=&copy; 1988 Taito Corporation &copy; 1989 Ocean Software Ltd. (Chase H.Q.) © 2023-2026 David Thomas (this disassembly)

[PageHeaders]
GameIndex=The incomplete<>disassembly

[Links]
Map=[Road map] (the road map)
Stage1Graphics=[Stage 1] (graphics specific to stage 1)
Stage1Map=[Stage 1] (map data for stage 1)
Stage2Graphics=[Stage 2] (graphics specific to stage 2)
Stage2Map=[Stage 2] (map data for stage 2)
Stage3Graphics=[Stage 3] (graphics specific to stage 3)
Stage3Map=[Stage 3] (map data for stage 3)
Stage4Graphics=[Stage 4] (graphics specific to stage 4)
Stage4Map=[Stage 4] (map data for stage 4)
Stage5Graphics=[Stage 5] (graphics specific to stage 5)
Stage5Map=[Stage 5] (map data for stage 5)
CommonGraphics=[Common] (graphics common to all stages)
TitleGraphics=[Title screen] (the animated title screen, bank 3)
EndScreenGraphics=[End screen] (the end-of-game results screen, bank 7)

