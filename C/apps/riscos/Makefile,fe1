# Native RISC OS ChaseHQ application.

COMPONENT  = ChaseHQ
TARGET     = !ChaseHQ
OBJS       = o.host \
             o.kempston o.keyboard o.screen o.spectrum o.z80 \
             o.bank3 o.bank7 o.create o.main \
             o.commondata o.soundsamples o.stage1data o.stage2data \
             o.stage3data o.stage4data o.stage5data o.stages
CDEFINES   = -D__riscos -DCHQ_SILENT
INITTARGET = riscos_layout
CLEANTARGET = clean_layout

ifdef BUILD64
OBJS       += o.fullscreen
CDEFINES   += -DFULLSCREEN_ONLY
INCLUDES   = C:,C/apps/riscos,C/include,C/libraries,C/libraries/ZXSpectrum,C/libraries/ChaseHQ/Engine,C/libraries/ChaseHQ/Data
else
OBJS       += o.riscos
# Use the RISC_OSLib exported under C: by the build environment.  No local
# RISC_OSLib headers or objects are required.
LIBS       = C:RISC_OSLib.o.risc_oslib
INCLUDES   = .rotransform/riscos/h
VPATH      = .rotransform/riscos
endif

include CApp

.PHONY: riscos_layout clean_layout test

riscos_layout:
	sh C/apps/riscos/make-riscos-layout

clean_layout:
	${WIPE} .rotransform.riscos ${WFLAGS}

${ODIR}.chqtest: riscos_layout
	${CC} ${BUILD_CFLAGS} ${CDEFINES} ${INCLUDES} -o $@ .rotransform/riscos/c/chqtest

${AIFDIR}.ChaseTest: ${ODIR}.chqtest ${ODIR}.host ${ODIR}.keyboard \
                     ${ODIR}.kempston ${ODIR}.screen ${ODIR}.spectrum
	${LD} ${LDFLAGS} -o $@ ${ODIR}.chqtest ${ODIR}.screen \
	      ${ODIR}.spectrum ${ODIR}.keyboard ${ODIR}.kempston \
	      ${ODIR}.host ${CLIB}

test: riscos_layout ${AIFDIR}.ChaseTest
	riscos-build-run ${AIFDIR}/ChaseTest,ff8 --command ChaseTest

